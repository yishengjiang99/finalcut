# xAI API Token
# Get your token from https://console.x.ai/
XAI_API_TOKEN=your_xai_api_token_here
# Optional xAI model ids (defaults: grok-4.3). Use ids listed by GET https://api.x.ai/v1/models.
# XAI_CHAT_MODEL=grok-4.3      # chat and tool calling
# XAI_UTILITY_MODEL=grok-4.3   # caption translation, FFmpeg CLI string, lyric fallback
# XAI_CLIENT_MODEL=grok-4.3    # on-device (iOS) turns; setting it also forwards thumbnails as images

# OpenAI API Key (required for speaker diarization via batch /v1/audio/transcriptions)
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API key (optional: streaming captions). The server uses it only to mint short-lived,
# single-use realtime-STT tokens for the browser; the key itself is never sent to the client.
# Without it POST /api/streaming-captions/token answers 503 and the app uses the older caption flow.
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_API_BASE=https://api.elevenlabs.io   # optional: a regional/residency host

# Stripe API Keys
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_SUBSCRIPTION_PRICE_ID=price_1StDJe4OymfcnKESq2dIraNE

# Google OAuth Credentials
# Get your credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Google iOS OAuth client ID (audience for mobile idTokens from Google Sign-In SDK)
# Create an iOS OAuth client in Google Cloud Console; leave blank to only accept web client audience
# GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com

# Mobile Bearer access token TTL in milliseconds (default: 30 days)
# MOBILE_ACCESS_TOKEN_TTL_MS=2592000000

# Session Secret
# Generate a random string for session encryption
SESSION_SECRET=your_random_session_secret_here

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=finalcut

# Server Port (optional, defaults to 3001)
PORT=3001

# NODE_ENV: leave unset here (development defaults locally). In production it comes from the
# systemd unit (finalcut.service: Environment=NODE_ENV=production), and `npm run build` sets it
# for the Vite build. Vite warns about NODE_ENV in .env files.

# Allowed CORS Origins for production (optional)
# Comma-separated list of allowed origins
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# ALLOWED_ORIGINS=

# iOS free daily limit. "unlimited" turns it off for iOS clients (mobile Bearer / FinalCap-iOS UA);
# unset or any other value keeps IOS_FREE_DAILY_INFERENCE_LIMIT (default 3). Restart to apply.
# FREE_EDITS_IOS=unlimited
# Optional: HMAC key for chat turnTokens (per-edit-turn quota). Defaults to SESSION_SECRET.
# TURN_TOKEN_SECRET=
# iOS suggestion pills live override (keep it outside the app dir; deploys wipe it). See docs/api/IOS_SUGGESTIONS.md.
# IOS_SUGGESTIONS_PATH=/home/finalcut/config/ios-suggestions.json
# Admin API for the pills (GET/PUT /api/admin/ios-suggestions). 404 while unset or < 24 chars. Generate with `openssl rand -hex 32`;
# the directory of IOS_SUGGESTIONS_PATH must be writable by the service user.
# ADMIN_API_TOKEN=

# Kept from the old .env.production template. The current server does not read these.
# MAX_BODY_SIZE=50mb
# REQUEST_TIMEOUT=600000
# DEBUG=false

# Public origin of the web app. Local dev: set to the Vite origin so Google login (which calls
# back on the API port) returns to the dev server. Leave unset in production behind nginx.
# APP_BASE_URL=http://localhost:5173

# --- Push notifications (docs/push-lifecycle.md) ---
# Lifecycle mode: off | dry_run (default) | sandbox | allowlist | live. Nothing real is sent until
# this is sandbox/allowlist/live AND the APNS_* values below are set.
# PUSH_LIFECYCLE_MODE=dry_run
# Comma-separated users.device_install_id (or users.id) that receive real pushes in allowlist mode.
# PUSH_LIFECYCLE_ALLOWLIST=
# Global kill switch: true stops all evaluation and sending (also: workflow "Push lifecycle (FinalCap)").
# PUSH_KILL_SWITCH=false
# PUSH_LIFECYCLE_SCHEDULER=true      # in-process 10-minute scheduler
# PUSH_COPY_GROK=true                # false = template copy only
# PUSH_COPY_MODEL=grok-4.20-0309-non-reasoning
# Admin HTTP routes /api/push/lifecycle/* (404 while unset; >= 16 chars). Prefer the workflow.
# PUSH_ADMIN_SECRET=
# APNs token auth (.p8 from developer.apple.com → Keys, team-wide; topic com.ragnus.w2)
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_P8_PATH=/etc/finalcut/AuthKey.p8      # or APNS_P8_CONTENTS with \n escapes
# FINALCAP_APNS_TOPIC=com.ragnus.w2

# Server-side ad conversions (docs/marketing/ad-conversions.md). Leave empty to disable (no-op).
X_ADS_PIXEL_ID=
X_ADS_EVENT_IDS=
X_ADS_CONSUMER_KEY=
X_ADS_CONSUMER_SECRET=
X_ADS_ACCESS_TOKEN=
X_ADS_ACCESS_TOKEN_SECRET=
REDDIT_ADS_PIXEL_ID=
REDDIT_ADS_ACCESS_TOKEN=
REDDIT_ADS_TEST_ID=
REDDIT_ADS_EVENTS=
