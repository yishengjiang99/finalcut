{
  "name": "finalcut",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ffmpeg-core.mjs && concurrently \"npx vite .\" \"nodemon server.js\"",
    "dev:client": "node scripts/copy-ffmpeg-core.mjs && npx vite .",
    "dev:server": "nodemon server.js",
    "build": "node scripts/copy-ffmpeg-core.mjs && NODE_ENV=production vite build",
    "build:v2": "node scripts/copy-ffmpeg-core.mjs && node scripts/fetch-ffmpeg-source.mjs && vite build -c vite.v2.config.js",
    "dev:v2": "node scripts/copy-ffmpeg-core.mjs && node scripts/fetch-ffmpeg-source.mjs && vite -c vite.v2.config.js",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:smoke": "vitest --run src/test/App.test.jsx src/test/auth-routing.test.js src/test/health.test.js src/test/jobs-api.test.js",
    "server": "node server.js",
    "start": "node server.js",
    "deploy:grepawk": "./scripts/deploy-grepawk.sh",
    "test:live-captions": "vitest --run src/test/live-captions.e2e.test.js",
    "test:playwright:live-captions": "playwright test tests/playwright/live-captions.spec.js",
    "fixture:elevenlabs-caption": "node scripts/generate-elevenlabs-caption-fixture.js",
    "ios": "./scripts/run-ios-device.sh",
    "ios:simulator": "./scripts/run-ios-simulator.sh",
    "schema:tools": "node scripts/generate-tools-schema.js",
    "test:e2e:v2": "playwright test -c tests/e2e/playwright.config.mjs",
    "test:contract:ios": "node tests/contract/ios-endpoints.mjs",
    "source:verify": "node scripts/fetch-ffmpeg-source.mjs --verify"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/core-mt": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@huggingface/transformers": "4.3.1",
    "axios": "^1.13.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.2",
    "express-session": "^1.19.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.5",
    "multer": "^2.1.1",
    "mysql2": "^3.16.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stripe": "^20.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.1",
    "jsdom": "^23.0.1",
    "nodemon": "^3.1.10",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
